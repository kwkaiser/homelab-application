{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "gitAuthor": "Renovate Bot <bot@renovateapp.com>",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "major": {
    "dependencyDashboardApproval": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["codewithcj/sparkyfitness", "codewithcj/sparkyfitness_server"],
      "groupName": "sparkyfitness"
    },
    {
      "matchPackageNames": ["postgres", "postgis/postgis", "redis"],
      "additionalBranchPrefix": "{{parentDir}}-",
      "commitMessageSuffix": "({{parentDir}})"
    },
    {
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["linuxserver/calibre-web"],
      "allowedVersions": "<1"
    },
    {
      "matchPackageNames": ["linuxserver/qbittorrent"],
      "allowedVersions": "<14"
    },
    {
      "matchPackageNames": ["git.kwkaiser.io/kwkaiser/housing", "git.kwkaiser.io/kwkaiser/housing-web"],
      "groupName": "housing",
      "versioning": "semver",
      "automerge": true,
      "automergeType": "pr",
      "dependencyDashboardApproval": false
    }
  ]
}
